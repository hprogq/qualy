# One deployment's settings. Copy to `.env` beside compose.yaml and fill in.
#
# Two readers: docker compose substitutes ${...} in compose.yaml from this
# file, and the server and migrate containers receive it whole (env_file).
# The sandbox containers receive none of it. Keep this file out of version
# control and out of images; nothing in the repository ever reads it.

# --- the release --------------------------------------------------------------
# The tag the three images were built with (`pnpm release:build <release>`):
# qualy-server:<release>, qualy-sandbox-runtime:<release>,
# qualy-sandbox-authoring:<release>. The release that serves: set it by hand
# for the first deployment's deploy job and seed; deploy/upgrade.sh and
# rollback.sh keep it from then on.
QUALY_RELEASE=
# Written by the scripts, not by hand: which color serves, and which release
# each color last ran. An upgrade starts the idle color on the new release
# and stops the other; a rollback goes back to what the idle one holds.
QUALY_ACTIVE_COLOR=
QUALY_RELEASE_BLUE=
QUALY_RELEASE_GREEN=

# --- the database -------------------------------------------------------------
POSTGRES_USER=qualy
POSTGRES_PASSWORD=
POSTGRES_DB=qualy
# what the server and the migrate job connect to: the compose service, by name
DATABASE_URL=postgres://qualy:CHANGE_ME@postgres:5432/qualy

# --- the process --------------------------------------------------------------
# Where each color's server port is published on this host. Loopback by
# default: the edge proxy (ops/reverse-proxy) terminates TLS and forwards to
# the serving color's port.
QUALY_BIND=127.0.0.1
QUALY_PORT_BLUE=3001
QUALY_PORT_GREEN=3002
# The proxy tier the server stands behind, as addresses or CIDR blocks,
# comma separated. Forwarded headers are believed from these peers only;
# empty means the socket peer is the client. With the edge proxy on this
# host talking to the published loopback port, the peer the container sees
# is the gateway of compose.yaml's network, which it fixes at 172.30.53.1.
# Left empty behind a proxy, every visitor shares that one address in the
# sign-in rate limits and one person can lock everybody out. Empty is right
# only when QUALY_BIND publishes the port to the world with no proxy.
QUALY_TRUSTED_PROXIES=172.30.53.1
# The network's address plan, only if 172.30.53.0/24 is taken on this host;
# the gateway above must then follow.
# QUALY_NETWORK_SUBNET=172.30.53.0/24
# QUALY_NETWORK_GATEWAY=172.30.53.1
# info | debug | warn | error; json is what a log shipper wants
QUALY_LOG_LEVEL=info
QUALY_LOG_FORMAT=json
# api | all | off (default api): which requests the access log records
# QUALY_ACCESS_LOG=api
# seconds a stopping server waits for in-flight work before forcing exit
# QUALY_SHUTDOWN_TIMEOUT=30
# report | enforce: the browser shell's content security policy mode. The
# product's default is report; a deployment enforces it.
QUALY_CSP_MODE=enforce
# How many web releases the deploy job keeps in the web_releases volume for
# tabs still running an earlier one: at least the newest COUNT, and every one
# installed in the last HOURS (defaults 5 and 72). The current one always stays.
# QUALY_WEB_RELEASE_RETAIN_COUNT=5
# QUALY_WEB_RELEASE_RETAIN_HOURS=72
# auto | off | public: auto serves the API reference outside production only
# QUALY_API_DOCS=auto

# --- the edge and the upgrade scripts ----------------------------------------
# caddy, or none on a host with no edge. The snippet the
# site imports, which the scripts rewrite to point at a color and validate
# and reload (ops/reverse-proxy/Caddyfile).
QUALY_PROXY=caddy
QUALY_PROXY_UPSTREAM=/etc/caddy/qualy/upstream.caddy
# QUALY_PROXY_VALIDATE=caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
# QUALY_PROXY_RELOAD=systemctl reload caddy
# where the scripts ask the edge which release it serves; QUALY_PUBLIC_URL by default
# QUALY_PROXY_CHECK_URL=
# seconds the old color keeps serving what reached it before the switch
QUALY_DRAIN_SECONDS=20
# where an upgrade backs up first; unset, it says it took none
QUALY_BACKUP_ROOT=/var/backups/qualy
# run by sh with the new backup directory as $1, to copy it off this host
# (docs/deployment.md §3.3); a failure fails the backup
# QUALY_BACKUP_OFFSITE=coscli -c /etc/qualy/coscli.yaml cp -r "$1" cos://<backup-bucket>/qualy/
# what an upgrade needs free before it starts a second color (MB)
# QUALY_UPGRADE_MIN_MEMORY_MB=600
# QUALY_UPGRADE_MIN_DISK_MB=2048

# --- resources ----------------------------------------------------------------
# Ceilings for a small host shared with other work. The server's heap stays
# under its container's limit, so it collects garbage rather than being
# killed. PostgreSQL's own defaults assume it has the machine to itself.
# QUALY_SERVER_MEMORY=768m
# QUALY_SERVER_HEAP_MB=512
# QUALY_PG_SHARED_BUFFERS=256MB
# QUALY_PG_EFFECTIVE_CACHE_SIZE=1GB
# QUALY_PG_WORK_MEM=8MB
# QUALY_PG_MAINTENANCE_WORK_MEM=64MB

# --- sign-in ------------------------------------------------------------------
# The key every secret a tenant gives the product is encrypted under, such as
# a login entrance's client secret. Exactly 32 bytes of base64:
#   openssl rand -base64 32
# Required: a production process without it does not start. Keep it with this
# file's other secrets and back it up - what is already stored cannot be read
# without it, and replacing it does not re-encrypt anything.
QUALY_SECRETS_MASTER_KEY=
# How long a session may go unused before it ends, in seconds (default 7200,
# two hours; 0 for no idle limit; at least 600). A page left open does not keep
# itself signed in: only what its reader does counts as use. Sessions still end
# a week after sign-in whatever this says.
# QUALY_SESSION_IDLE_SECONDS=7200
# Where the outside world reaches this deployment, as an origin and nothing
# else - https, such as https://qualy.example.edu. Required: the server does
# not start without it. Every link the product mails - setting a forgotten
# password, proving or changing an address - is written with it, and a login
# entrance that redirects to a school's server or another sign-in service is
# sent back to it, so it is never taken from the request.
QUALY_PUBLIC_URL=
# The private networks a login entrance's upstream may live on - a school's
# CAS server inside its own network - as hostnames, addresses or CIDR blocks,
# comma-separated. Empty means public addresses only. Loopback, link-local
# space and cloud metadata services are never reachable, whatever is listed.
# QUALY_AUTH_PRIVATE_PROVIDER_ALLOWLIST=cas.intra.school.edu,10.20.0.0/16
# A demonstration deployment's shared accounts: offered on the sign-in page
# with their passwords, and frozen - nobody can change their password,
# address or ways in, and no reset mail is sent for them. Unset everywhere
# else.
# QUALY_DEMO_ACCOUNTS=[{"email":"student@demo.example.edu","password":"…","label":"学生"}]
# The tenant an anonymous visitor signs in to. Unset means `default`.
# QUALY_DEFAULT_TENANT=default

# --- mail ---------------------------------------------------------------------
# Who mail comes from, and the Resend key it goes out with (qualy.yml sends
# mail through Resend). A production process without either does not start:
# mail from a placeholder domain is rejected or read as spam, and that is
# found out the day somebody needs a reset. The sender's domain must be one
# Resend has verified.
QUALY_MAIL_FROM=
QUALY_MAIL_RESEND_API_KEY=
# An SMTP relay instead: QUALY_MAIL_DEFAULT_BACKEND=smtp, and then the key
# above is no longer needed, but these are:
# QUALY_MAIL_DEFAULT_BACKEND=smtp
# QUALY_MAIL_SMTP_HOST=
# implicit (TLS from the first byte, port 465), starttls (upgrade that must
# succeed, port 587, the default) or none (in the clear; refused unless
# QUALY_MAIL_SMTP_ALLOW_PLAINTEXT=1). The port follows the choice unless set.
# QUALY_MAIL_SMTP_TLS=starttls
# QUALY_MAIL_SMTP_PORT=587
# The relay's account, both or neither.
# QUALY_MAIL_SMTP_USER=
# QUALY_MAIL_SMTP_PASSWORD=

# --- attachments --------------------------------------------------------------
# The default backend for new uploads; only backends whose plugin is enabled
# in qualy.yml count. `local` writes into the `storage` volume
# (QUALY_STORAGE_LOCAL_ROOT is set by compose.yaml to that mount).
QUALY_STORAGE_DEFAULT_BACKEND=local
# The cloud backend, when @qualy/plugin-storage-cos is enabled in the
# release's manifest. The secrets live here and nowhere else. Without them the
# backend takes part unconfigured: it cannot be the default, and attachments
# it wrote answer 503 until they are back. With them, the bucket and region
# must be known too (here or in the manifest).
# QUALY_STORAGE_COS_REGION=ap-beijing
# QUALY_STORAGE_COS_BUCKET=
# QUALY_STORAGE_COS_SECRET_ID=
# QUALY_STORAGE_COS_SECRET_KEY=
# QUALY_STORAGE_COS_DOWNLOAD_DOMAIN=

# --- sandboxes ----------------------------------------------------------------
# QuickJS workers in the runtime sandbox: one per CPU of its quota
QUALY_SANDBOX_POOL_SIZE=1

# --- browser failure reporting (when @qualy/plugin-rum-tencent is enabled) ----
# Off unless on. On needs the reporting id below, or the server refuses to
# start; off serves no settings and adds no host to the page's policy.
# QUALY_RUM_REPORTING=on
# QUALY_RUM_TENCENT_ID=
# QUALY_RUM_TENCENT_ENV=production
# QUALY_RUM_TENCENT_SAMPLE_RATE=1

# --- telemetry ----------------------------------------------------------------
# Off until the collector runs: `docker compose --profile telemetry up -d
# otel-collector`, with collector.env beside this file (collector.env.example).
# Traces, metrics and logs then go to it, and from it to Tencent Cloud.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_LOGS_EXPORTER=otlp
# the same stable name for this host as collector.env gives
# QUALY_INSTANCE_ID=

# --- CAPTCHA --------------------------------------------------------------------
# ALTCHA, the default provider, needs nothing here: its keys are derived from
# QUALY_SECRETS_MASTER_KEY. Cloudflare Turnstile is off by default and only
# for regions Cloudflare serves (not mainland China); enable it in qualy.yml,
# disable altcha, and set both of these. The site key is public, the secret
# key never leaves the server.
# QUALY_CAPTCHA_TURNSTILE_SITE_KEY=
# QUALY_CAPTCHA_TURNSTILE_SECRET_KEY=

# --- an imported baseline (deploy/demo/restore.sh) ----------------------------
# The passwords this deployment gives the five accounts a demonstration
# baseline carries, set on every import: the administrator and the four
# demonstration people. The import refuses to start while any is unset. Held
# to the sign-in page's own rules (at least 15 characters, nothing of the
# person's name or address).
# QUALY_BASELINE_PASSWORD_ADMIN=
# QUALY_BASELINE_PASSWORD_STUDENT=
# QUALY_BASELINE_PASSWORD_CLASS_LEAD=
# QUALY_BASELINE_PASSWORD_COUNSELLOR=
# QUALY_BASELINE_PASSWORD_LEAD=
