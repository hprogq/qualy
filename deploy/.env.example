# One deployment's settings. Copy to `.env` beside compose.yaml and fill in.
#
# Two readers: docker compose substitutes ${...} in compose.yaml from this
# file, and the server and migrate containers receive it whole (env_file).
# The sandbox containers receive none of it. Keep this file out of version
# control and out of images; nothing in the repository ever reads it.

# --- the release --------------------------------------------------------------
# The tag the three images were built with (`pnpm release:build <release>`):
# qualy-server:<release>, qualy-sandbox-runtime:<release>,
# qualy-sandbox-authoring:<release>. Changing it and running the deploy steps
# again is an upgrade; changing it back is an image rollback, which is not a
# schema rollback (docs/deployment.md).
QUALY_RELEASE=

# --- the database -------------------------------------------------------------
POSTGRES_USER=qualy
POSTGRES_PASSWORD=
POSTGRES_DB=qualy
# what the server and the migrate job connect to: the compose service, by name
DATABASE_URL=postgres://qualy:CHANGE_ME@postgres:5432/qualy

# --- the process --------------------------------------------------------------
# Where the server's port is published on this host. Loopback by default: the
# edge proxy (ops/reverse-proxy) terminates TLS and forwards to it.
QUALY_BIND=127.0.0.1
QUALY_PORT=3000
# The proxy tier the server stands behind, as addresses or CIDR blocks,
# comma separated. Forwarded headers are believed from these peers only;
# empty means the socket peer is the client. With the edge proxy on this
# host talking to the published loopback port, the peer the container sees
# is the docker gateway, e.g. 172.16.0.0/12.
QUALY_TRUSTED_PROXIES=
# info | debug | warn | error; json is what a log shipper wants
QUALY_LOG_LEVEL=info
QUALY_LOG_FORMAT=json
# api | all | off (default api): which requests the access log records
# QUALY_ACCESS_LOG=api
# seconds a stopping server waits for in-flight work before forcing exit
# QUALY_SHUTDOWN_TIMEOUT=30
# report | enforce: the browser shell's content security policy mode
# QUALY_CSP_MODE=report
# auto | off | public: auto serves the API reference outside production only
# QUALY_API_DOCS=auto

# --- attachments --------------------------------------------------------------
# The default backend for new uploads; only backends whose plugin is enabled
# in qualy.yml count. `local` writes into the `storage` volume
# (QUALY_STORAGE_LOCAL_ROOT is set by compose.yaml to that mount).
QUALY_STORAGE_DEFAULT_BACKEND=local
# The cloud backend, when @qualy/plugin-storage-cos is enabled in the
# release's manifest. Region and bucket live in the manifest; the secrets
# live here and nowhere else.
# QUALY_STORAGE_COS_SECRET_ID=
# QUALY_STORAGE_COS_SECRET_KEY=
# QUALY_STORAGE_COS_DOWNLOAD_DOMAIN=

# --- sandboxes ----------------------------------------------------------------
# QuickJS workers in the runtime sandbox: one per CPU of its quota
QUALY_SANDBOX_POOL_SIZE=1

# --- browser failure reporting (when @qualy/plugin-rum-tencent is enabled) ----
# QUALY_RUM_TENCENT_ID=
# QUALY_RUM_TENCENT_ENV=production
# QUALY_RUM_TENCENT_SAMPLE_RATE=1

# --- telemetry ----------------------------------------------------------------
# Off until a collector exists; ops/observability has the collector configs.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_LOGS_EXPORTER=otlp
# QUALY_INSTANCE_ID=
