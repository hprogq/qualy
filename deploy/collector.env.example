# The collector's own environment. Copy to collector.env beside compose.yaml
# (never committed) and fill in from the Tencent console. Only the
# otel-collector container receives it; none of it reaches the server.

# APM, private-network access: gRPC over TLS on 4320
TENCENT_APM_ENDPOINT=pl.ap-beijing.apm.tencentcs.com:4320
TENCENT_APM_TOKEN=

# CLS, OTLP/HTTP direct ingestion on the private-network domain, HTTP Basic
# Auth over a CAM credential that may upload to the topic and do nothing else
TENCENT_CLS_ENDPOINT=https://ap-beijing.cls.tencentyun.com
TENCENT_CLS_TOPIC_ID=
TENCENT_CLS_SECRET_ID=
TENCENT_CLS_SECRET_KEY=

# TMP (managed Prometheus), Prometheus remote write on the instance's private
# address, which the server must be able to reach (the console's Basic
# Information page lists it as http://<address>:9090/api/v1/prom/write), and
# the instance's token
TENCENT_TMP_REMOTE_WRITE_URL=
TENCENT_TMP_TOKEN=

# this host's stable name, also set as QUALY_INSTANCE_ID in .env
QUALY_INSTANCE_ID=
