{
  "name": "qualy",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@cordisjs/plugin-include": "catalog:",
    "@cordisjs/plugin-loader": "catalog:",
    "@cordisjs/plugin-logger-console": "catalog:",
    "@cordisjs/plugin-timer": "catalog:",
    "cordis": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cordisjs/plugin-hmr": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "scripts": {
    "build": "tsx scripts/gen.ts --all && pnpm --filter web build",
    "db:generate": "drizzle-kit generate && tsx scripts/drop-guard.ts",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "docker compose down -v && docker compose up -d && pnpm db:migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "pnpm db:migrate && node --expose-internals --env-file-if-exists=.env --import tsx packages/app/src/main.ts",
    "dev:web": "pnpm --filter web dev",
    "format": "prettier --write .",
    "gen": "tsx scripts/gen.ts",
    "plugin:add": "tsx scripts/plugin-add.ts",
    "test": "vitest run",
    "typecheck": "tsx scripts/typecheck.ts"
  }
}
