{
  "name": "qualy",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@qualy/api-kit": "workspace:*",
    "@qualy/assembly": "workspace:*",
    "@qualy/assembly-contract": "workspace:*",
    "@qualy/i18n-contract": "workspace:*",
    "@qualy/plugin-auth": "workspace:*",
    "@qualy/plugin-database": "workspace:*",
    "@qualy/plugin-kit": "workspace:*",
    "@qualy/plugin-org": "workspace:*",
    "@qualy/plugin-ping": "workspace:*",
    "@qualy/plugin-ui-registry": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "effect": "catalog:",
    "pg": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "pnpm --filter @qualy/web-app build && tsx scripts/stage-web-assets.ts",
    "db:reset": "docker compose down -v && docker compose up -d --wait && tsx scripts/qualy.ts deploy",
    "dev": "node --env-file-if-exists=.env --import tsx scripts/run-server.ts development",
    "format": "prettier --write .",
    "plugin:add": "tsx scripts/plugin-add.ts",
    "prepare": "effect-language-service patch",
    "qualy": "tsx scripts/qualy.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:all": "pnpm test && pnpm test:browser",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsx scripts/typecheck.ts",
    "vendor:update": "tsx scripts/vendor-sync.ts update",
    "vendor:restore": "tsx scripts/vendor-sync.ts restore",
    "vendor:check": "tsx scripts/vendor-sync.ts check",
    "start": "node --env-file-if-exists=.env --import tsx scripts/run-server.ts production"
  }
}
