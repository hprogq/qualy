{
  "name": "qualy",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "scripts": {
    "build": "tsx scripts/gen.ts --all && pnpm --filter @qualy/web-app build && tsx scripts/stage-web-assets.ts",
    "db:generate": "drizzle-kit generate && tsx scripts/drop-guard.ts",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:reset": "docker compose down -v && docker compose up -d && pnpm db:migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "pnpm db:migrate && node --expose-internals --env-file-if-exists=.env --import tsx packages/app/src/main.ts",
    "format": "prettier --write .",
    "gen": "tsx scripts/gen.ts",
    "plugin:add": "tsx scripts/plugin-add.ts",
    "test": "vitest run",
    "typecheck": "tsx scripts/typecheck.ts"
  }
}
