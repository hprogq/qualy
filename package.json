{
  "name": "qualy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@cordisjs/plugin-include": "catalog:",
    "@cordisjs/plugin-loader": "catalog:",
    "@cordisjs/plugin-logger-console": "catalog:",
    "@cordisjs/plugin-timer": "catalog:",
    "@qualy/plugin-ping": "workspace:*",
    "cordis": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cordisjs/plugin-hmr": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "dev": "node --expose-internals --env-file-if-exists=.env --import tsx packages/app/src/main.ts",
    "dev:web": "pnpm --filter web dev",
    "gen": "tsx scripts/gen-schema.ts && tsx scripts/gen-contracts.ts && tsx scripts/gen-plugins.ts",
    "build": "pnpm gen && pnpm --filter web build",
    "db:generate": "tsx scripts/gen-schema.ts && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit"
  }
}
