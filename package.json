{
  "name": "qualy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx node_modules/cordis/bin.js",
    "dev:web": "pnpm --filter web dev",
    "gen": "tsx scripts/gen-schema.ts && tsx scripts/gen-contracts.ts && tsx scripts/gen-plugins.ts",
    "build": "pnpm gen && pnpm --filter web build",
    "db:generate": "tsx scripts/gen-schema.ts && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run"
  }
}
