#!/bin/sh
# The deployment host's launcher: the one part of a deployment that is not
# part of a release. Installed once by root as /usr/local/sbin/qualy-deploy,
# owned by root, writable by nobody else, and never replaced by a release
# (ops/deploy-host/README.md).
#
#   qualy-deploy check
#   qualy-deploy doctor
#   qualy-deploy image-gc-preview
#   qualy-deploy fetch    <release> <server> <sandbox-runtime> <sandbox-authoring>
#   qualy-deploy deploy   <release> <server> <sandbox-runtime> <sandbox-authoring> [--maintenance]
#   qualy-deploy rollback
#
# A release carries its own deploy/ - the scripts and compose files that move
# a deployment onto it - because the scripts and the images are one
# compatible unit. This takes that deploy/ out of the exact server image it
# was asked for and runs it. What it trusts is a digest in the registry
# /etc/qualy/deploy.conf names, which only root writes; it never runs a script
# handed to it, and the caller chooses nothing but the release and the three
# digests (sha256:<64 hex>, in the order above).
#
# fetch pulls the three images by digest, checks that they are one release -
# each labelled <release>, one committed revision - names them
# qualy-*:<release> on this host (refusing a name that already names other
# images) and extracts the server image's deploy/ to
# <root>/releases/<release>/, owned by root. deploy fetches, then runs that
# release's upgrade.sh. rollback runs the serving release's rollback.sh: the
# release it goes back to is the older one, and its scripts may not know
# what the newer ones wrote to .env. Either way the scripts run under this
# launcher's lock, with <root>/.env as their env file; afterwards
# <root>/current points at the release .env records as serving, which is
# where backups, restores and the edge's maintenance page find their files.
# current means that and nothing else: fetch never touches it, and nothing
# points it at a release that does not serve.
#
# The deploy workflow reaches it over SSH through a forced command. That
# account has no docker and no sudo beyond this one file, so the command
# line arrives as SSH_ORIGINAL_COMMAND, is split into words here and handed
# to this same file through sudo, where every word is checked.
#
# POSIX sh, and `local`: every name a helper assigns is local to it, except
# release, revision and held, which the helpers share on purpose.
set -eu
umask 022

if [ "$(id -u)" -ne 0 ]; then
  if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
    set -f
    # split into words on purpose; each is checked below, as root
    # shellcheck disable=SC2086
    set -- $SSH_ORIGINAL_COMMAND
  fi
  exec sudo -n /usr/local/sbin/qualy-deploy "$@"
fi

conf=/etc/qualy/deploy.conf
IMAGES='qualy-server qualy-sandbox-runtime qualy-sandbox-authoring'

say() {
  printf 'qualy-deploy: %s\n' "$*"
}
refuse() {
  printf 'qualy-deploy: %s\n' "$*" >&2
  exit 1
}
usage() {
  refuse "usage: qualy-deploy check | doctor | image-gc-preview | fetch <release> <server> <sandbox-runtime> <sandbox-authoring> | deploy <release> <server> <sandbox-runtime> <sandbox-authoring> [--maintenance] | rollback"
}

release_name() {
  case $1 in *[!A-Za-z0-9._-]*) return 1 ;; esac
  printf '%s\n' "$1" | grep -Eqx 'v[0-9A-Za-z][0-9A-Za-z._-]{0,62}'
}

image_digest() {
  case $1 in *[!a-z0-9:]*) return 1 ;; esac
  printf '%s\n' "$1" | grep -Eqx 'sha256:[0-9a-f]{64}'
}

# settings are read, never sourced
[ -f "$conf" ] || refuse "no $conf"
setting() {
  sed -n "s/^$1=//p" "$conf" | tail -n 1
}
registry=$(setting QUALY_DEPLOY_REGISTRY)
root=$(setting QUALY_DEPLOY_ROOT)
root=${root:-/opt/qualy}
printf '%s' "$registry" | grep -Eqx '[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+' ||
  refuse "QUALY_DEPLOY_REGISTRY in $conf is not a registry path like docker.cnb.cool/<org>/<repo>"
case $root in /*) ;; *) refuse "QUALY_DEPLOY_ROOT in $conf is not an absolute path" ;; esac
[ -d "$root" ] || refuse "no $root"
env_file=$root/.env

# check and fetch run before a deployment has its settings; the scripts do not
need_env() {
  [ -f "$env_file" ] || refuse "no $env_file: write the deployment's settings first (deploy/.env.example)"
}
env_value() {
  [ -f "$env_file" ] || return 0
  sed -n "s/^$1=//p" "$env_file" | tail -n 1
}

# the lock the release's scripts take (deploy/lib.sh), taken here first so
# that fetching and running are one step; the scripts inherit it
held=
take_lock() {
  if command -v flock > /dev/null 2>&1; then
    exec 9> "$env_file.lock"
    flock -n 9 || refuse "another deployment step holds $env_file.lock"
  else
    mkdir "$env_file.lock.d" 2> /dev/null || refuse "another deployment step holds $env_file.lock.d"
    held=$env_file.lock.d
    trap 'rmdir "$held"' EXIT
  fi
  QUALY_DEPLOY_LOCK_HELD=$env_file
  export QUALY_DEPLOY_LOCK_HELD
}

revision=
# pulls one image and checks it belongs to the release; names nothing yet
pull() {
  local ref labels version commit id named
  ref=$registry/$1@$2
  # the registry's read-only credential lives beside deploy.conf, apart from
  # root's own docker login, which other deployments on this host may use
  docker --config "$(dirname "$conf")/docker" pull --quiet "$ref" > /dev/null ||
    refuse "could not pull $ref"
  labels=$(docker image inspect -f '{{index .Config.Labels "org.opencontainers.image.version"}} {{index .Config.Labels "org.opencontainers.image.revision"}}' "$ref")
  version=${labels%% *}
  commit=${labels#* }
  [ "$version" = "$release" ] || refuse "$ref is labelled release ${version:-none}, not $release"
  case $commit in '' | *-dirty) refuse "$ref was not built from a commit (${commit:-no revision})" ;; esac
  [ -z "$revision" ] || [ "$revision" = "$commit" ] ||
    refuse "$ref was built from $commit, the images before it from $revision"
  revision=$commit
  id=$(docker image inspect -f '{{.Id}}' "$ref")
  named=$(docker image inspect -f '{{.Id}}' "$1:$release" 2> /dev/null || true)
  [ -z "$named" ] || [ "$named" = "$id" ] ||
    refuse "$1:$release already names another image on this host; a release name names one set of images"
}

extract() {
  local dest work container
  dest=$root/releases/$release
  if [ "$(cat "$dest/server-digest" 2> /dev/null || true)" = "$1" ]; then
    say "$release's deploy scripts are in $dest/deploy"
    return 0
  fi
  mkdir -p "$root/releases"
  work=$(mktemp -d "$root/releases/.$release.XXXXXX")
  chmod 755 "$work"
  container=$(docker create "$registry/qualy-server@$1")
  if ! docker cp "$container:/app/deploy" "$work/deploy" > /dev/null; then
    docker rm "$container" > /dev/null 2>&1 || true
    rm -rf "$work"
    refuse "the server image of $release carries no deploy/"
  fi
  docker rm "$container" > /dev/null
  # root runs these: nobody else may change them
  chown -R 0:0 "$work"
  chmod -R go-w "$work"
  printf '%s\n' "$1" > "$work/server-digest"
  rm -rf "$dest"
  mv "$work" "$dest"
  say "$release's deploy scripts are in $dest/deploy"
}

fetch() {
  local digest server digests image
  release=$1
  release_name "$release" ||
    refuse "$release is not a release name (v...)"
  for digest in "$2" "$3" "$4"; do
    image_digest "$digest" ||
      refuse "$digest is not an image digest (sha256:<64 hex>)"
  done
  server=$2
  digests="$2 $3 $4"
  set -- $digests
  for image in $IMAGES; do
    pull "$image" "$1"
    shift
  done
  # all three are the release: only now do they get its name
  set -- $digests
  for image in $IMAGES; do
    docker tag "$registry/$image@$1" "$image:$release"
    say "$image:$release is $registry/$image@$1"
    shift
  done
  extract "$server"
}

# runs one of a release's scripts, then points current at what serves
run() {
  local scripts script status serving
  scripts=$root/releases/$1/deploy
  script=$2
  shift 2
  [ -x "$scripts/$script" ] || refuse "no $scripts/$script; fetch that release first"
  status=0
  QUALY_ENV_FILE=$env_file "$scripts/$script" "$@" || status=$?
  serving=$(env_value QUALY_RELEASE)
  if [ -n "$serving" ] && [ -d "$root/releases/$serving/deploy" ]; then
    ln -sfn "releases/$serving" "$root/current"
  fi
  return "$status"
}

# A complete release that this launcher fetched, still pointing at the
# expected registry. Unknown, retagged or incomplete groups stay put.
# Print the server image's build time for ordering, not the tag or directory's
# mtime (pulling an old release again does not make it a newer build).
image_group() {
  local tag refs server build revision used removal image ref info id created version commit tags digests digest origin named local_name
  tag=$1
  refs=$2
  server=$(cat "$root/releases/$tag/server-digest") || return 1
  image_digest "$server" || return 1
  revision=
  used=no
  removal=
  for image in $IMAGES; do
    ref=$image:$tag
    info=$(docker image inspect -f '{{.Id}}|{{.Created}}|{{with index .Config "Labels"}}{{index . "org.opencontainers.image.version"}}|{{index . "org.opencontainers.image.revision"}}{{else}}|{{end}}|{{join .RepoTags " "}}|{{join .RepoDigests " "}}' "$ref" 2>/dev/null) || return 1
    IFS='|' read -r id created version commit tags digests <<EOF
$info
EOF
    [ "$version" = "$tag" ] && image_digest "$id" || return 1
    case $commit in '' | *-dirty) return 1 ;; esac
    [ -z "$revision" ] || [ "$commit" = "$revision" ] || return 1
    revision=$commit
    origin=
    for digest in $digests; do
      case $digest in
        "$registry/$image@"*)
          [ -z "$origin" ] || return 1
          origin=${digest##*@}
          image_digest "$origin" || return 1
          ;;
        "$image@$id") ;; # Docker may also report a digest under the local name
        *) return 1 ;;
      esac
    done
    [ -n "$origin" ] || return 1
    local_name=no
    for named in $tags; do
      case $named in
        "$ref") local_name=yes ;;
        "$registry/$image@$origin")
          # The containerd image store keeps a separate reference after a
          # digest pull. Untagging only the local name does not free it.
          removal="$removal $named"
          ;;
        *) return 1 ;;
      esac
    done
    [ "$local_name" = yes ] || return 1
    removal="$removal $ref"
    if [ "$image" = qualy-server ]; then
      [ "$origin" = "$server" ] || return 1
      printf '%s\n' "$created" | grep -Eqx '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z' || return 1
      build=$created
    fi
    case " $refs " in *" $id "* | *" $ref "* | *" $registry/$image@$origin "*) used=yes ;; esac
  done
  printf '%s %s %s%s\n' "$build" "$tag" "$used" "$removal"
}

image_gc() (
  local mode keep active serving blue green standby ids refs dir tag groups ranked spare build used removal planned failed
  mode=$1
  active=$(env_value QUALY_ACTIVE_COLOR)
  serving=$(env_value QUALY_RELEASE)
  blue=$(env_value QUALY_RELEASE_BLUE)
  green=$(env_value QUALY_RELEASE_GREEN)
  case $active in
    blue) [ "$serving" = "$blue" ] || return 1; standby=$green ;;
    green) [ "$serving" = "$green" ] || return 1; standby=$blue ;;
    *) return 1 ;;
  esac
  release_name "$serving" && [ "$serving" = "${2:-$serving}" ] &&
    [ "$(readlink "$root/current")" = "releases/$serving" ] || return 1
  [ -z "$standby" ] || release_name "$standby" || return 1
  if [ "$mode" = apply ]; then
    rm -f "$root/releases/$serving/prefetched" || return 1
  fi
  keep=$(setting QUALY_DEPLOY_IMAGE_KEEP)
  keep=${keep:-3}
  case $keep in
    0) say 'image cleanup is disabled'; return 0 ;;
    [1-9] | [1-9][0-9]) ;;
    *) say 'invalid QUALY_DEPLOY_IMAGE_KEEP (expected 0-99)' >&2; return 1 ;;
  esac
  spare=$((keep - 1))
  if [ -n "$standby" ] && [ "$standby" != "$serving" ]; then
    spare=$((spare - 1))
  fi

  # Inspect all states and use the image ID as well as the original name:
  # a stopped container can have been created by digest or a different tag.
  ids=$(docker container ls --all --quiet --no-trunc) || return 1
  refs=$(
    set -f
    set -- $ids
    [ "$#" -eq 0 ] || docker container inspect -f '{{.Image}} {{.Config.Image}}' "$@"
  ) || return 1
  refs=$(printf '%s' "$refs" | tr '\n' ' ')

  groups=
  for dir in "$root"/releases/v*; do
    [ -f "$dir/server-digest" ] || continue
    tag=${dir##*/}
    release_name "$tag" || continue
    [ "$tag" != "$blue" ] && [ "$tag" != "$green" ] && [ ! -e "$dir/prefetched" ] || continue
    build=$(image_group "$tag" "$refs") || continue
    groups="$groups
$build"
  done
  ranked=$(printf '%s\n' "$groups" | LC_ALL=C sort -r) || return 1
  planned=no
  failed=0
  set -f
  while read -r build tag used removal; do
    [ -n "$tag" ] || continue
    if [ "$spare" -gt 0 ]; then
      spare=$((spare - 1))
      continue
    fi
    [ "$used" = no ] || continue
    planned=yes
    set -- $removal
    if [ "$mode" = preview ]; then
      say "would remove $*"
    elif docker image rm --no-prune "$@" > /dev/null; then
      say "removed local images for $tag"
    else
      say "WARNING: could not remove all local images for $tag" >&2
      failed=1
    fi
  done <<EOF
$ranked
EOF
  if [ "$mode" = preview ] && [ "$planned" = no ]; then
    say 'no local release images are eligible for cleanup'
  fi
  return "$failed"
)

case ${1:-} in
  check)
    [ $# -eq 1 ] || usage
    say "docker $(docker version --format '{{.Server.Version}}' 2> /dev/null || echo unreachable)"
    say "serving: $(env_value QUALY_ACTIVE_COLOR) $(env_value QUALY_RELEASE)"
    say "current: $(readlink "$root/current" 2> /dev/null || echo none)"
    say "releases: $(ls "$root/releases" 2> /dev/null | tr '\n' ' ')"
    ;;
  # The serving release's own deploy/doctor.sh: every fact a deployment
  # should hold, PASS / WARN / FAIL, non-zero when one fails. It only reads,
  # so it takes no lock and runs beside an upgrade as well as alone.
  doctor)
    [ $# -eq 1 ] || usage
    [ -x "$root/current/deploy/doctor.sh" ] ||
      refuse "the serving release ($(readlink "$root/current" 2> /dev/null || echo none)) carries no deploy/doctor.sh"
    QUALY_ENV_FILE=$root/.env exec "$root/current/deploy/doctor.sh"
    ;;
  image-gc-preview)
    [ $# -eq 1 ] || usage
    need_env
    take_lock
    image_gc preview || refuse 'could not plan image cleanup; nothing was removed'
    ;;
  fetch)
    [ $# -eq 5 ] || usage
    take_lock
    fetch "$2" "$3" "$4" "$5"
    touch "$root/releases/$release/prefetched"
    ;;
  deploy)
    [ $# -eq 5 ] || { [ $# -eq 6 ] && [ "$6" = --maintenance ]; } || usage
    need_env
    take_lock
    fetch "$2" "$3" "$4" "$5"
    if [ $# -eq 6 ]; then run "$2" upgrade.sh "$2" --maintenance; else run "$2" upgrade.sh "$2"; fi
    if ! image_gc apply "$2"; then
      say "WARNING: $2 is deployed, but image cleanup did not finish" >&2
    fi
    ;;
  rollback)
    [ $# -eq 1 ] || usage
    need_env
    take_lock
    serving=$(env_value QUALY_RELEASE)
    [ -n "$serving" ] || refuse "nothing serves yet; there is nothing to roll back"
    release_name "$serving" ||
      refuse "$env_file records $serving as serving, which is not a release name"
    run "$serving" rollback.sh
    ;;
  *) usage ;;
esac
