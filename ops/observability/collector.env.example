# Copy to ops/observability/collector.env (gitignored) and fill in the real
# values from the Tencent console. Compose feeds the file to the collector
# service only.

# APM public OTLP access (gRPC/TLS)
TENCENT_APM_ENDPOINT=ap-beijing.apm.tencentcs.com:4320
TENCENT_APM_TOKEN=

# CLS OTLP/HTTP direct ingestion (public endpoint, HTTP Basic Auth over
# SecretId/SecretKey, topic addressed by header). No LogListener involved.
TENCENT_CLS_ENDPOINT=https://ap-beijing.cls.tencentcs.com
TENCENT_CLS_TOPIC_ID=
TENCENT_CLS_SECRET_ID=
TENCENT_CLS_SECRET_KEY=
