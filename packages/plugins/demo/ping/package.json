{
  "name": "@qualy/plugin-ping",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./schema": "./src/db/schema.ts",
    "./client": "./client/index.ts",
    "./ui": "./src/ui.ts",
    "./api": "./src/api.ts",
    "./effect": "./src/effect/index.ts"
  },
  "qualy": {
    "contributions": {
      "database": {
        "schemaEntry": "src/db/schema.ts"
      }
    },
    "runtime": {
      "entry": "./effect",
      "api": "./api",
      "dependsOn": [
        "@qualy/plugin-database"
      ]
    }
  },
  "peerDependencies": {
    "cordis": "catalog:",
    "react": "catalog:"
  },
  "dependencies": {
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@qualy/api-contract": "workspace:*",
    "@qualy/i18n-contract": "workspace:*",
    "@qualy/plugin-server": "workspace:*",
    "@qualy/plugin-ui-registry": "workspace:*",
    "@qualy/ui-contract": "workspace:*",
    "@qualy/web-runtime": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:",
    "@qualy/api-kit": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:"
  }
}
