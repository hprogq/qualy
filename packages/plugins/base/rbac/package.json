{
  "name": "@qualy/plugin-rbac",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./db": "./src/db/entities.ts",
    "./permissions": "./src/permissions.ts",
    "./ui": "./src/ui.ts",
    "./client": "./client/index.ts",
    "./server": "./src/server/index.ts",
    "./api": "./src/api.ts",
    "./package.json": "./package.json",
    "./assembly": "./src/assembly/index.ts"
  },
  "qualy": {
    "contributions": {
      "database": {
        "dependsOn": [
          "@qualy/plugin-org",
          "@qualy/plugin-auth"
        ],
        "entitiesEntry": "src/db/entities.ts"
      },
      "permissions": {
        "entry": "src/permissions.ts"
      }
    },
    "runtime": {
      "entry": "./server",
      "dependsOn": [
        "@qualy/plugin-database",
        "@qualy/plugin-ui-registry"
      ],
      "api": "./api"
    },
    "capabilityProvider": {
      "key": "permissions",
      "entry": "./assembly"
    }
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "dependencies": {
    "@mikro-orm/core": "catalog:",
    "@qualy/api-client": "workspace:*",
    "@qualy/api-kit": "workspace:*",
    "@qualy/assembly-contract": "workspace:*",
    "@qualy/i18n-contract": "workspace:*",
    "@qualy/plugin-auth": "workspace:*",
    "@qualy/plugin-database": "workspace:*",
    "@qualy/plugin-org": "workspace:*",
    "@qualy/plugin-ui-registry": "workspace:*",
    "@qualy/rbac-contract": "workspace:*",
    "@qualy/ui": "workspace:*",
    "@qualy/ui-contract": "workspace:*",
    "@qualy/web-i18n": "workspace:*",
    "@qualy/web-runtime": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "effect": "catalog:",
    "kysely": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:"
  }
}
