{
  "name": "@qualy/plugin-rbac",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/db/schema.ts",
    "./permissions": "./src/permissions.ts",
    "./ui": "./src/ui.ts",
    "./contract": "./src/contract.ts",
    "./client": "./client/index.ts"
  },
  "qualy": {
    "database": {
      "schemaEntry": "src/db/schema.ts",
      "dependsOn": [
        "@qualy/plugin-org",
        "@qualy/plugin-auth"
      ]
    },
    "permissions": {
      "entry": "src/permissions.ts"
    }
  },
  "peerDependencies": {
    "cordis": "catalog:",
    "react": "catalog:"
  },
  "dependencies": {
    "@orpc/server": "catalog:",
    "@qualy/api-contract": "workspace:*",
    "@qualy/i18n-contract": "workspace:*",
    "@qualy/plugin-auth": "workspace:*",
    "@qualy/plugin-database": "workspace:*",
    "@qualy/plugin-org": "workspace:*",
    "@qualy/plugin-server": "workspace:*",
    "@qualy/plugin-ui-registry": "workspace:*",
    "@qualy/rbac-contract": "workspace:*",
    "@qualy/ui": "workspace:*",
    "@qualy/ui-contract": "workspace:*",
    "@qualy/web-i18n": "workspace:*",
    "@qualy/web-runtime": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:"
  }
}
