{
  "name": "@qualy/plugin-org",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./schema": "./src/db/schema.ts",
    "./permissions": "./src/permissions.ts",
    "./client": "./client/index.ts",
    "./ui": "./src/ui.ts",
    "./effect": "./src/effect/index.ts",
    "./api": "./src/api.ts",
    "./errors": "./src/errors.ts",
    "./package.json": "./package.json"
  },
  "qualy": {
    "contributions": {
      "database": {
        "schemaEntry": "src/db/schema.ts",
        "baselineDir": "db/baseline"
      }
    },
    "permissions": {
      "entry": "src/permissions.ts"
    },
    "runtime": {
      "entry": "./effect",
      "dependsOn": [
        "@qualy/plugin-database",
        "@qualy/plugin-rbac",
        "@qualy/plugin-auth"
      ],
      "api": "./api"
    }
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@qualy/plugin-auth": "workspace:*",
    "@qualy/plugin-database": "workspace:*",
    "@qualy/plugin-rbac": "workspace:*",
    "@types/react": "catalog:"
  },
  "dependencies": {
    "@qualy/api-client": "workspace:*",
    "@qualy/api-contract": "workspace:*",
    "@qualy/api-kit": "workspace:*",
    "@qualy/auth-contract": "workspace:*",
    "@qualy/i18n-contract": "workspace:*",
    "@qualy/plugin-auth": "workspace:*",
    "@qualy/plugin-ui-registry": "workspace:*",
    "@qualy/rbac-contract": "workspace:*",
    "@qualy/ui": "workspace:*",
    "@qualy/ui-contract": "workspace:*",
    "@qualy/web-i18n": "workspace:*",
    "@qualy/web-runtime": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "zod": "catalog:"
  }
}
