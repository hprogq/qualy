{
  "name": "@qualy/plugin-auth-local",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./password": "./src/password.ts",
    "./client": "./client/index.ts",
