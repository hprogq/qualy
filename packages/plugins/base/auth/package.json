{
  "name": "@qualy/plugin-auth",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./schema": "./src/db/schema.ts",
    "./client": "./client/index.ts",
    "./permissions": "./src/permissions.ts",
    "./ui": "./src/ui.ts",
    "./constants": "./src/constants.ts",
    "./effect": "./src/effect/index.ts",
    "./effect/session": "./src/effect/session.ts",
    "./api": "./src/api.ts",
    "./effect/sign-in": "./src/effect/sign-in.ts"
  },
  "qualy": {
    "contributions": {
      "database": {
        "schemaEntry": "src/db/schema.ts",
        "dependsOn": [
          "@qualy/plugin-org"
        ]
      }
    },
    "permissions": {
      "entry": "src/permissions.ts"
    },
    "runtime": {
      "entry": "./effect",
      "dependsOn": [
        "@qualy/plugin-database",
        "@qualy/plugin-rbac"
      ],
      "api": "./api"
    }
  },
  "peerDependencies": {
    "cordis": "catalog:",
    "react": "catalog:"
  },
  "dependencies": {
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@qualy/api-client": "workspace:*",
    "@qualy/api-contract": "workspace:*",
    "@qualy/auth-contract": "workspace:*",
    "@qualy/i18n-contract": "workspace:*",
    "@qualy/plugin-database": "workspace:*",
    "@qualy/plugin-org": "workspace:*",
    "@qualy/plugin-server": "workspace:*",
    "@qualy/plugin-ui-registry": "workspace:*",
    "@qualy/rbac-contract": "workspace:*",
    "@qualy/ui": "workspace:*",
    "@qualy/ui-contract": "workspace:*",
    "@qualy/web-i18n": "workspace:*",
    "@qualy/web-runtime": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "cookie": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "react-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@qualy/api-kit": "workspace:*",
    "@qualy/plugin-auth-local": "workspace:*",
    "@qualy/plugin-rbac": "workspace:*",
    "@qualy/plugin-ui-registry": "workspace:*",
    "@types/react": "catalog:"
  }
}
