# dependencies
node_modules/

# build outputs
dist/
build/
out/
*.tsbuildinfo

# staged web assets
client-dist/

# legacy source clones
legacy/

# vendored upstream sources: restored by `pnpm vendor:sync` from the commit
# vendor-lock.json pins, which is what makes them reproducible. Committing the
# trees added 7,759 files to a repository with 376 of its own.
repos/*
!repos/vendor-lock.json

# generated files
**/*.gen.ts

# environment
.env
.env.*
!.env.example

# logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
lerna-debug.log*

# test & coverage
coverage/
.nyc_output/

# caches
.cache/
.vite/
.turbo/
.eslintcache
.rollup.cache/

# OS
.DS_Store
Thumbs.db

# editors
.vscode/
.idea/
*.swp
*.swo

# misc
*.local
.vitest-attachments/

# vitest browser writes these when a test fails; they are diagnostics,
# not baselines, and nothing compares against them
apps/web/tests/__screenshots__/

# resolved runtime entry list, generated from qualy.yml
cordis.gen.yml

# materialised plugin aggregate, rewritten by the vite plugin on every start
apps/web/.qualy/

# scratch fixtures written by the effect diagnostics gate
.effect-diagnostics-*/
