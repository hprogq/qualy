# dependencies
node_modules/

# build outputs (anchored: packages/build/ is source, not output)
dist/
/build/
out/
*.tsbuildinfo

# staged web assets
client-dist/

# legacy source clones
legacy/

# vendored upstream sources: restored by `pnpm vendor:sync` from the commit
# vendor-lock.json pins, which is what makes them reproducible. Committing the
# trees added 7,759 files to a repository with 376 of its own.
repos/*
!repos/vendor-lock.json

# generated files
**/*.gen.ts

# environment
.env
.env.*
!.env.example

# the collector container's own environment: the one file that holds vendor
# telemetry credentials, which never enter the application process or git
ops/observability/collector.env

# logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
lerna-debug.log*

# test & coverage
coverage/
.nyc_output/

# caches
.cache/
.vite/
.turbo/
.eslintcache
.rollup.cache/

# OS
.DS_Store
Thumbs.db

# editors
.vscode/
.idea/
*.swp
*.swo

# misc
*.local
.vitest-attachments/

# vitest browser writes these when a test fails; they are diagnostics,
# not baselines, and nothing compares against them
apps/web/tests/__screenshots__/

# resolved runtime entry list, generated from qualy.yml
cordis.gen.yml

# materialised plugin aggregate, rewritten by the vite plugin on every start
apps/web/.qualy/

# attachments the local storage provider keeps when this machine is the
# deployment (its default root, ./data/storage; QUALY_STORAGE_LOCAL_ROOT moves
# it). Anchored: a package's own data/ fixtures are not this.
/data/

# scratch fixtures written by the effect diagnostics gate
.effect-diagnostics-*/

# assertion file the component-reference check writes into a plugin's client
# directory for the length of one tsc run; only a killed run leaves one behind
__qualy-component-check__.tsx

# agent tooling installed locally, not part of the repository
.claude/
.agents/
skills-lock.json

# per-machine MCP server wiring
.mcp.json

# the supervisor suite's own assembly, removed when it finishes and left
# behind only by a run that was killed
qualy.supervisor-test.yml
qualy.supervisor-test.lock.json
