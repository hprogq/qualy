{
  "extends": "./tsconfig.base.json",
  "include": [
    "*.config.ts",
    "tools",
    "apps/cli/src",
    "apps/sandbox-authoring/src",
    "apps/sandbox-authoring/tests",
    "apps/sandbox-runtime/src",
    "apps/sandbox-runtime/tests",
    "apps/server/src",
    "apps/server/tests",
    "packages/core/*/src",
    "packages/core/*/tests",
    "packages/contracts/*/src",
    "packages/contracts/*/tests",
    "packages/build/*/src",
    "packages/build/*/tests",
    "packages/plugins/*/*/src",
    "packages/plugins/*/*/tests"
  ],
  "exclude": [
    "packages/web",
    "packages/plugins/*/*/src/client",
    "packages/plugins/*/*/tests/**/*.tsx",
    "tools/fixtures/*/tests/**/*.tsx",
    "repos"
  ]
}
