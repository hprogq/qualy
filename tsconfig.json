{
  "extends": "./tsconfig.base.json",
  "include": [
    "*.config.ts",
    "tools",
    "apps/cli/src",
    "apps/sandbox-authoring/src",
    "apps/sandbox-runtime/src",
    "apps/server/src",
    "apps/server/tests",
    "packages/core/*/src",
    "packages/core/*/tests",
    "packages/contracts/*/src",
    "packages/contracts/*/tests",
    "packages/build/*/src",
    "packages/plugins/*/*/src",
    "packages/plugins/*/*/tests"
  ],
  "exclude": ["packages/web", "packages/plugins/*/*/src/client", "repos"]
}
