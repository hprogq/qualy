{
  "extends": "./tsconfig.base.json",
  "include": [
    "*.config.ts",
    "scripts",
    "apps/server/src",
    "apps/server/tests",
    "packages/*/src",
    "packages/*/tests",
    "packages/plugins/*/*/src",
    "packages/plugins/*/*/tests",
    "experiments/*/src",
    "experiments/*/tests"
  ],
  "exclude": [
    "packages/web-runtime",
    "packages/web-i18n",
    "packages/ui",
    "repos"
  ]
}
