{
  "extends": "./tsconfig.base.json",
  "include": [
    "*.config.ts",
    "tools",
    "apps/cli/src",
    "apps/server/src",
    "apps/server/tests",
    "packages/*/src",
    "packages/*/tests",
    "packages/build/*/src",
    "packages/plugins/*/*/src",
    "packages/plugins/*/*/tests"
  ],
  "exclude": [
    "packages/web-runtime",
    "packages/web-i18n",
    "packages/ui",
    "packages/plugins/*/*/src/client",
    "repos"
  ]
}
