# What every command here reads: `pnpm dev`, `pnpm start`, the CLI, the seed,
# and `docker compose`. Copy it to `.env`, which is not committed, and fill in
# what your machine needs. This file stays as the schema and the reference -
# it is the list of what exists and what each variable is for.
#
# Qualy reads standard environment variables: from this file's copy, from the
# shell, or both - and in Qualy's own processes a variable already set in the
# shell wins over `.env`. A regular `.env` on disk is the default and
# is fully supported. How a developer keeps their secrets is their own choice;
# nothing in the repository assumes one.
#
# A secret manager may instead mount `.env` as a named pipe (FIFO) that is
# written each time it is opened; 1Password Environments is one compatible
# option. A mounted environment may only be reliably readable once, so the
# development supervisor reads the environment once as the session starts and
# keeps that reading. Either way, after changing a variable, restart
# `pnpm dev`. Details and measurements: docs/notes/mounted-env.md.
#
# This file is the development machine's. A deployment has its own, next to
# deploy/compose.yaml, filled in from deploy/.env.example.

POSTGRES_USER=qualy
POSTGRES_PASSWORD=qualy
POSTGRES_DB=qualy
POSTGRES_PORT=5432
DATABASE_URL=postgres://qualy:qualy@localhost:5432/qualy

# The server `qualy generate` and `qualy database verify` build their two
# scratch databases on while comparing the committed lineage with the declared
# schema. Unset, the server DATABASE_URL names is used, which suits a
# development machine and CI. Development and CI only: production never
# generates a migration and never needs this.
# QUALY_GENERATION_DATABASE_URL=postgres://qualy:qualy@localhost:5432/postgres

# The key every secret a tenant gives the product is encrypted under: an
# entrance's client secret today, more later. Exactly 32 bytes of base64
# (`openssl rand -base64 32`); anything else is refused rather than stretched
# into a key. A development machine without one uses a key written in the
# source, which protects nothing and says so in the log; a production process
# without one does not start.
# QUALY_SECRETS_MASTER_KEY=

# The tenant an anonymous visitor signs in to, and the one `pnpm seed`
# provisions. Unset means `default`.
# QUALY_DEFAULT_TENANT=default

# What `pnpm seed` gives the tenant's system account: the email it signs in
# with at the password door, and its password (at least 12 characters). The
# seed creates the account when there is none, and gives an existing account
# that has no email yet this one; it never changes an email already set.
# QUALY_RESET_ADMIN_PASSWORD=1 replaces the password on the next run.
QUALY_ADMIN_EMAIL=admin@example.com
QUALY_ADMIN_PASSWORD=
# QUALY_RESET_ADMIN_PASSWORD=1
# QUALY_SEED_DEMO=1 adds example units, types and two demo accounts
# (manager@example.edu, student@example.edu) with this password.
# QUALY_SEED_DEMO=1
# QUALY_DEMO_PASSWORD=

# the throwaway cluster the compose stack runs beside the development one:
# no durability, no volume, and nothing in it outlives a test run
POSTGRES_TEST_PORT=5433
QUALY_TEST_DATABASE_URL=postgres://qualy:qualy@localhost:5433/qualy

# Where attachments go. The manifest names the default backend; this overrides
# it for one deployment, and only backends whose plugin is installed count.
QUALY_STORAGE_DEFAULT_BACKEND=local
QUALY_STORAGE_LOCAL_ROOT=./data/storage
# The cloud backend, when @qualy/plugin-storage-cos is enabled. Region and
# bucket also live in the manifest; the two secrets never do, and never here
# with a value either - set them in .env, which is not committed.
QUALY_STORAGE_COS_REGION=ap-beijing
QUALY_STORAGE_COS_BUCKET=
QUALY_STORAGE_COS_SECRET_ID=
QUALY_STORAGE_COS_SECRET_KEY=
QUALY_STORAGE_COS_DOWNLOAD_DOMAIN=
# Runs the cos suite against that bucket; without it those tests are skipped
QUALY_TEST_COS=0

# Browser failure reporting, when @qualy/plugin-rum and a provider are enabled.
# The reporting id is public - the browser sends it with every report - but it
# is one deployment's, so it is read here rather than built into the bundle.
# The numeric source map project id is NOT this, is not read by the
# application, and belongs to the release pipeline.
QUALY_RUM_TENCENT_ID=
# production | pre | gray | daily | test | local
QUALY_RUM_TENCENT_ENV=production
# a share of the traffic, greater than 0 and at most 1; out of range is refused
QUALY_RUM_TENCENT_SAMPLE_RATE=1

# The source map uploader (`qualy rum sourcemaps`), which a RELEASE
# pipeline runs after the build. None of this reaches the application: the
# process that serves requests never holds a cloud credential, and the numeric
# project id is the control plane's, not the browser reporting id above.
# Never a real value here - these belong in the pipeline's secret store.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
QUALY_TENCENT_RUM_PROJECT_ID=

# The browser shell's content security policy is reported, not enforced,
# until the reports have been quiet for long enough (docs/notes/auth-security.md,
# 「响应头」): report | enforce. Switching needs no code change.
#QUALY_CSP_MODE=report

# Telemetry is off until an OTLP endpoint exists. For the local stack
# (docker compose --profile observability up -d, Grafana on :3001) point it
# at the collector; see ops/observability/README.md. Everything else about
# telemetry speaks standard OTEL_* variables too.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Which collector config the compose profile mounts. Default is the local
# stack; collector.staging.yaml adds the Tencent APM trace uplink, whose
# credentials live in ops/observability/collector.env (gitignored, see its
# .example) - never in this file, never in the application process.
#QUALY_COLLECTOR_CONFIG=collector.staging.yaml
# Log export is opt-in even when the endpoint is set: without this line the
# stdout JSON logger is the only log surface. With it, every log record also
# reaches the collector (-> Loki locally, -> CLS on the staging config),
# carrying the trace/span ids of the emitting fiber.
#OTEL_LOGS_EXPORTER=otlp

# Sandbox process sockets (defaults shown; the container form binds the same
# host paths, so a plain `pnpm sandbox:up` needs no overrides)
# QUALY_SANDBOX_RUNTIME_SOCKET=.qualy/run/sandbox/runtime/runtime.sock
# QUALY_SANDBOX_AUTHORING_SOCKET=.qualy/run/sandbox/authoring/authoring.sock
