POSTGRES_USER=qualy
POSTGRES_PASSWORD=qualy
POSTGRES_DB=qualy
POSTGRES_PORT=5432
DATABASE_URL=postgres://qualy:qualy@localhost:5432/qualy
# the throwaway cluster the compose stack runs beside the development one:
# no durability, no volume, and nothing in it outlives a test run
POSTGRES_TEST_PORT=5433
QUALY_TEST_DATABASE_URL=postgres://qualy:qualy@localhost:5433/qualy

# Where attachments go. The manifest names the default backend; this overrides
# it for one deployment, and only backends whose plugin is installed count.
QUALY_STORAGE_DEFAULT_BACKEND=local
QUALY_STORAGE_LOCAL_ROOT=./data/storage
# The cloud backend, when @qualy/plugin-storage-cos is enabled. Region and
# bucket also live in the manifest; the two secrets never do, and never here
# with a value either - set them in .env, which is not committed.
QUALY_STORAGE_COS_REGION=ap-beijing
QUALY_STORAGE_COS_BUCKET=
QUALY_STORAGE_COS_SECRET_ID=
QUALY_STORAGE_COS_SECRET_KEY=
QUALY_STORAGE_COS_DOWNLOAD_DOMAIN=
# Runs the cos suite against that bucket; without it those tests are skipped
QUALY_TEST_COS=0

# Telemetry is off until an OTLP endpoint exists. For the local stack
# (docker compose --profile observability up -d, Grafana on :3001) point it
# at the collector; see ops/observability/README.md. Everything else about
# telemetry speaks standard OTEL_* variables too.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Which collector config the compose profile mounts. Default is the local
# stack; collector.staging.yaml adds the Tencent APM trace uplink, whose
# credentials live in ops/observability/collector.env (gitignored, see its
# .example) - never in this file, never in the application process.
#QUALY_COLLECTOR_CONFIG=collector.staging.yaml
# Log export is opt-in even when the endpoint is set: without this line the
# stdout JSON logger is the only log surface. With it, every log record also
# reaches the collector (-> Loki locally, -> CLS on the staging config),
# carrying the trace/span ids of the emitting fiber.
#OTEL_LOGS_EXPORTER=otlp
